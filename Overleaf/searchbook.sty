% ------------------------------------------------------------------
% Coloured boxes (tcolorbox) and theorem-like environments
% ------------------------------------------------------------------
\RequirePackage[most]{tcolorbox}
\tcbset{
  sbboxbase/.style={enhanced,breakable,boxrule=0.6pt,arc=2pt,left=8pt,right=8pt,top=6pt,bottom=6pt,
    before skip=10pt,after skip=10pt,fonttitle=\sffamily\bfseries,coltitle=white,
    attach boxed title to top left={yshift=-2mm,xshift=4mm},
    boxed title style={arc=1pt,boxrule=0pt,left=5pt,right=5pt,top=2pt,bottom=2pt}},
}
% Learning objectives: at the start of every chapter
\newtcolorbox{objectives}{sbboxbase,colback=sbLightBlue,colframe=sbBlue,colbacktitle=sbBlue,title=Learning objectives}
% Key idea / intuition box
\newtcolorbox{keyidea}[1][Key idea]{sbboxbase,colback=sbLightGreen,colframe=sbGreen,colbacktitle=sbGreen,title={#1}}
% Where the algorithm sits in the drone system
\newtcolorbox{dronebox}[1][In the drone system]{sbboxbase,colback=sbLightPurple,colframe=sbPurple,colbacktitle=sbPurple,title={#1}}
% Pitfalls, warnings and common mistakes
\newtcolorbox{pitfall}[1][Pitfall]{sbboxbase,colback=sbLightOrange,colframe=sbOrange,colbacktitle=sbOrange,title={#1}}
% Chapter summary
\newtcolorbox{summary}[1][Chapter summary]{sbboxbase,colback=sbLightGray,colframe=sbGray,colbacktitle=sbGray,title={#1}}
% Historical or "further reading" note
\newtcolorbox{historynote}[1][Historical note]{sbboxbase,colback=white,colframe=sbGray!70,colbacktitle=sbGray!80,title={#1}}
% Generic titled note
\newtcolorbox{notebox}[1]{sbboxbase,colback=white,colframe=sbBlue!70,colbacktitle=sbBlue!80,title={#1}}

% Theorem-like environments (all share one counter per chapter, so they are
% numbered in reading order: Definition 4.1, Example 4.2, Theorem 4.3, ...)
% The environments share one counter, but each gets an alias counter so that
% cleveref names them correctly ("Theorem 4.3", not "Definition 4.3").
\RequirePackage{aliascnt}
\theoremstyle{definition}
\newtheorem{definition}{Definition}[chapter]
\newaliascnt{example}{definition}
\newtheorem{example}[example]{Example}
\aliascntresetthe{example}
\theoremstyle{plain}
\newaliascnt{theorem}{definition}
\newtheorem{theorem}[theorem]{Theorem}
\aliascntresetthe{theorem}
\newaliascnt{lemma}{definition}
\newtheorem{lemma}[lemma]{Lemma}
\aliascntresetthe{lemma}
\newaliascnt{proposition}{definition}
\newtheorem{proposition}[proposition]{Proposition}
\aliascntresetthe{proposition}
\newaliascnt{corollary}{definition}
\newtheorem{corollary}[corollary]{Corollary}
\aliascntresetthe{corollary}
\theoremstyle{remark}
\newaliascnt{remark}{definition}
\newtheorem{remark}[remark]{Remark}
\aliascntresetthe{remark}
\newtheorem{exercise}{Exercise}[chapter]
\tcolorboxenvironment{definition}{blanker,breakable,borderline west={2.5pt}{0pt}{sbBlue},left=8pt,before skip=8pt,after skip=8pt,colback=sbLightBlue!50}
\tcolorboxenvironment{example}{blanker,breakable,borderline west={2.5pt}{0pt}{sbGreen},left=8pt,before skip=8pt,after skip=8pt,colback=sbLightGreen!60}
\tcolorboxenvironment{theorem}{blanker,breakable,borderline west={2.5pt}{0pt}{sbPurple},left=8pt,before skip=8pt,after skip=8pt}
\tcolorboxenvironment{lemma}{blanker,breakable,borderline west={2.5pt}{0pt}{sbPurple},left=8pt,before skip=8pt,after skip=8pt}
\tcolorboxenvironment{proposition}{blanker,breakable,borderline west={2.5pt}{0pt}{sbPurple},left=8pt,before skip=8pt,after skip=8pt}
\tcolorboxenvironment{corollary}{blanker,breakable,borderline west={2.5pt}{0pt}{sbPurple},left=8pt,before skip=8pt,after skip=8pt}
\tcolorboxenvironment{remark}{blanker,breakable,borderline west={2.5pt}{0pt}{sbGray},left=8pt,before skip=8pt,after skip=8pt}
\tcolorboxenvironment{exercise}{blanker,breakable,borderline west={2.5pt}{0pt}{sbOrange},left=8pt,before skip=6pt,after skip=6pt}
\tcolorboxenvironment{proof}{blanker,breakable,left=4pt,before skip=4pt,after skip=8pt}

