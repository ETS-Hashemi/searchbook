% \drawgrid{cols}{rows} draws a cols x rows unit grid with the origin at (0,0)
\newcommand{\drawgrid}[2]{\draw[black!40,very thin] (0,0) grid (#1,#2);}
% \gridobstacle{x}{y} fills the unit cell whose lower-left corner is (x,y)
\newcommand{\gridobstacle}[2]{\fill[sbobstacle] (#1,#2) rectangle ++(1,1);}
\newcommand{\gridopen}[2]{\fill[sbopen] (#1,#2) rectangle ++(1,1);}
\newcommand{\gridclosed}[2]{\fill[sbclosed] (#1,#2) rectangle ++(1,1);}

