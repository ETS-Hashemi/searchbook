  sbvecB/.style={sbvec,draw=sbAgentB},
  sbannot/.style={font=\footnotesize,text=sbGray},
  sbbox/.style={draw=sbBlue,fill=sbLightBlue,rounded corners=3pt,thick,align=center,inner sep=6pt,font=\small\sffamily},
