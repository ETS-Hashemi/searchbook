% ------------------------------------------------------------------
% Chapter and section headings, running heads
% ------------------------------------------------------------------
\RequirePackage{titlesec}
\titleformat{\chapter}[display]
  {\normalfont\sffamily\bfseries\color{sbBlue}}
  {\filleft\fontsize{56}{56}\selectfont\thechapter}
  {1ex}
  {\titlerule[1.2pt]\vspace{1.5ex}\filright\huge}
  [\vspace{1ex}]
\titlespacing*{\chapter}{0pt}{20pt}{28pt}
\titleformat{\section}{\normalfont\sffamily\Large\bfseries\color{sbBlue}}{\thesection}{1em}{}
\titleformat{\subsection}{\normalfont\sffamily\large\bfseries\color{sbBlue!85!black}}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\normalfont\sffamily\normalsize\bfseries\color{sbBlue!70!black}}{\thesubsubsection}{1em}{}
\titleformat{\paragraph}[runin]{\normalfont\normalsize\bfseries}{\theparagraph}{1em}{}
\setcounter{secnumdepth}{2}
\setcounter{tocdepth}{1}

\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\chaptermark}[1]{\markboth{\chaptername\ \thechapter.\ #1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\ #1}}
\fancyhead[L]{\small\sffamily\color{sbGray}\nouppercase{\leftmark}}
\fancyhead[R]{\small\sffamily\color{sbGray}\nouppercase{\rightmark}}
\fancyfoot[C]{\small\sffamily\thepage}
\renewcommand{\headrulewidth}{0.3pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\small\sffamily\thepage}\renewcommand{\headrulewidth}{0pt}}

