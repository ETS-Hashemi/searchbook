\@writefile{lof}{\contentsline {figure}{\numberline {1.8}{\ignorespaces The basin experiment. (a) $441$ starts in front of a peanut-shaped obstacle with the goal at $(8, 4.1)$: blue dots reach the goal, orange squares end in the local minimum at $(2.676, 4.1)$ (red cross), grey curves are the trajectories from the column $x = 0$; the basin is a band around the symmetry axis holding $41\,\%$ of the starts. (b) A single-drone run from the trapped start $(0, 4.1)$ with random-walk escapes (green), drawn from its own random stream: after $8$ walks and $3\,810$ steps the drone finds the way round the upper lobe. In the batch run of (a) the same start is still walking when the horizon expires.}}{20}{figure.caption.23}\protected@file@percent }
\newlabel{fig:ch15-basin}{{1.8}{20}{The basin experiment. (a) $441$ starts in front of a peanut-shaped obstacle with the goal at $(8, 4.1)$: blue dots reach the goal, orange squares end in the local minimum at $(2.676, 4.1)$ (red cross), grey curves are the trajectories from the column $x = 0$; the basin is a band around the symmetry axis holding $41\,\%$ of the starts. (b) A single-drone run from the trapped start $(0, 4.1)$ with random-walk escapes (green), drawn from its own random stream: after $8$ walks and $3\,810$ steps the drone finds the way round the upper lobe. In the batch run of (a) the same start is still walking when the horizon expires}{figure.caption.23}{}}
\newlabel{fig:ch15-basin@cref}{{[figure][8][1]1.8}{[1][19][]20}}
