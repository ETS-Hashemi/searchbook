\@writefile{lof}{\contentsline {figure}{\numberline {A.1}{\ignorespaces Conditioning the Gaussian of \cref  {ex:appB-conditioning}. The $1\sigma $ and $2\sigma $ ellipses of the joint density are tilted along the eigenvector $\mathbf  {q}_1$ of $\mathbf  {\Sigma }$. Observing $y = 2$ restricts the density to the dashed slice; along it, the conditional density of $x$ (orange) is centred at $3.2$, to the right of the prior mean $2$, and is narrower than the marginal density of $x$ (blue, drawn along the bottom) because knowing $y$ removes the part of the uncertainty of $x$ that is correlated with $y$.}}{18}{figure.caption.7}\protected@file@percent }
\newlabel{fig:appB-conditioning}{{A.1}{18}{Conditioning the Gaussian of \cref {ex:appB-conditioning}. The $1\sigma $ and $2\sigma $ ellipses of the joint density are tilted along the eigenvector $\vect {q}_1$ of $\mat {\Sigma }$. Observing $y = 2$ restricts the density to the dashed slice; along it, the conditional density of $x$ (orange) is centred at $3.2$, to the right of the prior mean $2$, and is narrower than the marginal density of $x$ (blue, drawn along the bottom) because knowing $y$ removes the part of the uncertainty of $x$ that is correlated with $y$}{figure.caption.7}{}}
\newlabel{fig:appB-conditioning@cref}{{[figure][1][2147483647,1]A.1}{[1][18][]18}}
