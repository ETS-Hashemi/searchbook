#!/usr/bin/env bash
# Build the book and produce the deliverables:
#   Overleaf/{{SHORT}}.pdf            compiled book
#   Overleaf/{{SHORT}}-overleaf.zip   Overleaf project package (main.tex at the zip root)
# SKIP_FIGCACHE=1 ./package.sh skips re-rendering the figure cache (fast rebuilds).
set -uo pipefail
cd "$(dirname "$0")"
python3 tools/assemble_glossary.py
if [ -z "${SKIP_FIGCACHE:-}" ]; then python3 tools/render_figures.py | tail -1; fi
./build.sh | tail -8
if [ -f build-full/main.pdf ]; then
  cp build-full/main.pdf {{SHORT}}.pdf
  rm -f {{SHORT}}-overleaf.zip
  zip -qr {{SHORT}}-overleaf.zip main.tex textbook.sty latexmkrc references.bib README.md build.sh package.sh \
      frontmatter chapters appendices figures figcache code bib tools -x "*/__pycache__/*" -x "*.pyc"
  echo "packaged: $(pdfinfo {{SHORT}}.pdf 2>/dev/null | grep Pages) ; $(unzip -l {{SHORT}}-overleaf.zip | tail -1)"
else
  echo "no PDF produced" >&2; exit 1
fi
